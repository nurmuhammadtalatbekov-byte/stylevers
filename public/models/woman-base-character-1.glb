        0.005, brows
    )

# NOSE
sphere("Nose bridge", (0, 0.105, 1.675), (0.014, 0.025, 0.043), skin)
sphere("Nose tip", (0, 0.13, 1.66), (0.022, 0.018, 0.014), skin)

# LIPS
sphere("Upper lip", (0, 0.105, 1.625), (0.027, 0.012, 0.008), lips)
sphere("Lower lip", (0, 0.106, 1.617), (0.024, 0.012, 0.009), lips)

# HAIR CAP
sphere("Hair crown", (0, -0.018, 1.765), (0.13, 0.12, 0.095), hair)

# LONG HAIR LOCKS
for side in [-1, 1]:
    x = side * 0.105

    curve_line(
        "Long hair",
