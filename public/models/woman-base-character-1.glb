
import bpy
import math
import os
from mathutils import Vector

# ==========================================
# STYLEVERSE - FEMALE FASHION SUPERMODEL
# Adult female character, 168 cm
# ==========================================

bpy.ops.object.select_all(action="SELECT")
bpy.ops.object.delete(use_global=False)

# MATERIALS
def material(name, color, roughness=0.55, metallic=0):
    mat = bpy.data.materials.new(name)
    mat.diffuse_color = (*color, 1)
    mat.use_nodes = True
    bsdf = mat.node_tree.nodes.get("Principled BSDF")
    bsdf.inputs["Base Color"].default_value = (*color, 1)
    bsdf.inputs["Roughness"].default_value = roughness
    bsdf.inputs["Metallic"].default_value = metallic
    return mat

skin = material("Warm natural skin", (0.66, 0.37, 0.26), 0.48)
hair = material("Dark chocolate hair", (0.045, 0.018, 0.012), 0.3)
hair_light = material("Hair highlights", (0.12, 0.045, 0.022), 0.35)
eyes = material("Deep brown eyes", (0.035, 0.012, 0.008), 0.2)
white = material("Eye whites", (0.9, 0.82, 0.72), 0.35)
lips = material("Rose lips", (0.48, 0.12, 0.15), 0.35)
brows = material("Eyebrows", (0.07, 0.025, 0.018), 0.6)
fabric = material("Midnight couture", (0.055, 0.025, 0.09), 0.55)
gold = material("Gold details", (0.65, 0.42, 0.13), 0.25, 0.7)

# OBJECT HELPERS
def sphere(name, location, scale, mat, segments=32):
    bpy.ops.mesh.primitive_uv_sphere_add(
        segments=segments,
        ring_count=24,
        location=location
    )
    obj = bpy.context.object
    obj.name = name
    obj.scale = scale
    bpy.ops.object.transform_apply(
        location=False, rotation=False, scale=True
    )
    obj.data.materials.append(mat)
    for p in obj.data.polygons:
        p.use_smooth = True
    return obj

def cylinder_between(name, start, end, radius, mat, radius2=None):
    a = Vector(start)
    b = Vector(end)
    direction = b - a
    mid = (a + b) / 2

    bpy.ops.mesh.primitive_cone_add(
        vertices=32,
        radius1=radius,
        radius2=radius if radius2 is None else radius2,
        depth=direction.length,
        location=mid
    )
    obj = bpy.context.object
    obj.name = name
    obj.rotation_mode = "QUATERNION"
    obj.rotation_quaternion = direction.to_track_quat("Z", "Y")
    obj.data.materials.append(mat)

    for p in obj.data.polygons:
        p.use_smooth = True
    return obj

def curve_line(name, points, bevel, mat):
    curve = bpy.data.curves.new(name, "CURVE")
    curve.dimensions = "3D"
    curve.resolution_u = 16
    curve.bevel_depth = bevel
    curve.bevel_resolution = 4

    spline = curve.splines.new("BEZIER")
    spline.bezier_points.add(len(points) - 1)

    for p, co in zip(spline.bezier_points, points):
        p.co = co
        p.handle_left_type = "AUTO"
        p.handle_right_type = "AUTO"

    obj = bpy.data.objects.new(name, curve)
    bpy.context.collection.objects.link(obj)
    obj.data.materials.append(mat)
    return obj

# BODY: smooth connected torso surface
levels = [
    (0.91, 0.17, 0.105),
    (1.00, 0.22, 0.125),
    (1.10, 0.155, 0.105),
    (1.22, 0.145, 0.105),
    (1.34, 0.205, 0.12),
    (1.43, 0.205, 0.115),
    (1.50, 0.105, 0.075),
]

verts = []
faces = []
steps = 48

for z, rx, ry in levels:
    for i in range(steps):
        angle = 2 * math.pi * i / steps
        verts.append((
            rx * math.cos(angle),
            ry * math.sin(angle),
            z
        ))

for row in range(len(levels) - 1):
    for i in range(steps):
        a = row * steps + i
        b = row * steps + (i + 1) % steps
        c = (row + 1) * steps + (i + 1) % steps
        d = (row + 1) * steps + i
        faces.append((a, b, c, d))

mesh = bpy.data.meshes.new("Female torso mesh")
mesh.from_pydata(verts, [], faces)
mesh.update()

torso = bpy.data.objects.new("Female torso", mesh)
bpy.context.collection.objects.link(torso)
torso.data.materials.append(skin)

for p in torso.data.polygons:
    p.use_smooth = True

sub = torso.modifiers.new("Smooth anatomy", "SUBSURF")
sub.levels = 2

# HIPS
sphere("Pelvis", (0, 0, 0.94), (0.225, 0.13, 0.17), skin)

# LEGS
for side in [-1, 1]:
    x = side * 0.105

    cylinder_between(
        "Upper leg",
        (x, 0, 0.98),
        (x * 1.12, 0, 0.52),
        0.092, skin, 0.068
    )

    sphere("Knee", (x * 1.12, 0, 0.51), (0.068, 0.07, 0.075), skin)

    cylinder_between(
        "Lower leg",
        (x * 1.12, 0, 0.52),
        (x * 1.22, 0.015, 0.13),
        0.064, skin, 0.045
    )

    sphere(
        "Foot",
        (x * 1.22, 0.045, 0.075),
        (0.065, 0.14, 0.055),
        skin
    )

# ARMS
for side in [-1, 1]:
    shoulder = (side * 0.205, 0, 1.40)
    elbow = (side * 0.34, 0.015, 1.12)
    wrist = (side * 0.37, 0.025, 0.88)

    sphere("Shoulder", shoulder, (0.085, 0.09, 0.105), skin)
    cylinder_between("Upper arm", shoulder, elbow, 0.052, skin, 0.042)
    sphere("Elbow", elbow, (0.045, 0.05, 0.05), skin)
    cylinder_between("Forearm", elbow, wrist, 0.042, skin, 0.028)
    sphere("Hand", wrist, (0.045, 0.035, 0.075), skin)

    for finger in range(4):
        fx = side * (0.35 + finger * 0.014)
        cylinder_between(
            "Finger",
            (fx, 0.025, 0.85),
            (fx + side * 0.006, 0.035, 0.79),
            0.009, skin, 0.006
        )

# NECK
cylinder_between(
    "Neck",
    (0, 0, 1.43),
    (0, 0, 1.59),
    0.057, skin, 0.052
)

# HEAD AND FACE
sphere("Head", (0, 0, 1.68), (0.115, 0.105, 0.15), skin)
sphere("Jaw", (0, 0.035, 1.605), (0.085, 0.078, 0.075), skin)

# EARS
for side in [-1, 1]:
    sphere(
        "Ear",
        (side * 0.113, 0, 1.665),
        (0.023, 0.025, 0.043),
        skin
    )

# EYES
for side in [-1, 1]:
    x = side * 0.043

    sphere("Eye white", (x, 0.092, 1.70), (0.027, 0.014, 0.014), white)
    sphere("Iris", (x, 0.105, 1.70), (0.012, 0.008, 0.012), eyes)
    sphere("Pupil", (x, 0.111, 1.70), (0.006, 0.004, 0.007), brows)

    curve_line(
        "Eyebrow",
        [
            (x - 0.025, 0.102, 1.728),
            (x, 0.112, 1.737),
            (x + 0.025, 0.102, 1.728)
